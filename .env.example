# ── Copy this file to .env and fill in the values ────────────────────────────
# cp .env.example .env

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change_this_db_password

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# App credentials (the single account you log in with)
APP_USERNAME=admin
APP_PASSWORD=change_this_app_password

# JWT signing secret — must be at least 32 characters, keep it secret!
JWT_SECRET=change-this-to-a-long-random-secret-string-min-32-chars

# Mail — set MAIL_ENABLED=true to activate email notifications on each Claude reply
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_TO=recipient@example.com
