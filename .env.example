# ── Copy this file to .env and fill in the values ────────────────────────────
# cp .env.example .env

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change_this_db_password

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# App credentials (the single account you log in with)
APP_USERNAME=admin
APP_PASSWORD=change_this_app_password

# JWT signing secret — must be at least 32 characters, keep it secret!
JWT_SECRET=change-this-to-a-long-random-secret-string-min-32-chars
